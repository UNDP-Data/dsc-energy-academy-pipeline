          "number": "8"
        },
        "title": "مستقبل الطاقة: الابتكار من أجل التنمية المستدامة",
        "cta": "مرر، استخدم علامة التبويب أو لوحة المفاتيح الخاصة بك للمضي قدمًا"
      }
    },
    {
      "template_id": "text",
      "color_scheme": "dark",
      "content": {
        "text_elements": [
          {
            "template_id": "subtitle",
            "content": {
              "text": "<strong>نظرة عامة على الوحدة</strong>"
            }
          },
          {
            "template_id": "paragraph_medium",
            "content": {
              "text": "يستكشف هذا الوحدة الإمكانات التحولية للابتكار في تشكيل مستقبل أنظمة الطاقة المستدامة. يفحص الاتجاهات الرئيسية والتقنيات والتحولات النظامية التي تدفع التحولات في مجال الطاقة على مستوى العالم، مع التركيز على القوى الاجتماعية والاقتصادية والجيوسياسية والبيئية التي تؤثر على الطلب والعرض على الطاقة. <br /><br />من خلال تحليل نقدي للبيئات الممكنة والقطاعات الناشئة والحلول العملية، يزود الوحدة المتعلمين بفهم والتنقل في المشهد المعقد للابتكار في مجال الطاقة. مع التركيز على الشمولية والمرونة والبصيرة الاستراتيجية، يُعد ممارسي برنامج الأمم المتحدة الإنمائي لدعم التحولات المدفوعة بالابتكار التي تكون عادلة ومستعدة للمستقبل ومتوافقة مع أهداف التنمية المستدامة."
            }
          }
        ]
      }
    },
