        "title": "关键概念",
        "intro": "探索本课的基础思想。",
        "concepts": [
          {
            "title": "关键矿物",
            "body": "关键矿物是用于生产高科技设备、可再生能源技术和其他先进应用的自然资源，且面临供应中断的风险。",
            "source": ""
          },
          {
            "title": "负责任的提取实践",
            "body": "负责任的开采实践是指获取自然资源的方法，优先考虑环境可持续性、社会公平和经济可行性，确保对生态系统和社区的伤害最小。",
            "source": ""
          },
          {
            "title": "可持续供应链",
            "body": "可持续供应链是指以最小化环境影响、促进社会责任并确保产品整个生命周期的经济可行性为目标的商品和服务流管理。",
            "source": ""
