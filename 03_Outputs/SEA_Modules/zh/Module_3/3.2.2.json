{
  "id": "3.2.2",
  "segments": [
    {
      "template_id": "lesson_cover",
      "color_scheme": "dark",
      "content": {
        "image": {
          "src": "https://sehseadata.blob.core.windows.net/images/Modules/Module_3/387_808.webp",
          "caption": ""
