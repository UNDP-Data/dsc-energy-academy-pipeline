{
  "id": "5.2.3",
  "segments": [
    {
      "template_id": "lesson_cover",
      "color_scheme": "dark",
      "content": {
        "image": {
          "src": "https://sehseadata.blob.core.windows.net/images/Modules/Module_5/4768_5899.webp",
