          "caption": "Off-grid renewable energy system (Source: The IGC)"
        }
      }
    },
    {
      "template_id": "photo_full_height",
      "color_scheme": "dark",
      "content": {
        "image": {
          "src": "https://sehseadata.blob.core.windows.net/images/Modules/Module_2/673_104.webp",
          "caption": ""
        }
