# Credentials stay local at every directory depth; examples contain no values.
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
.aws/
.azure/
.venv/
venv/

# Local OS / Python / notebook artifacts
.DS_Store
**/.DS_Store
__pycache__/
**/__pycache__/
*.py[cod]
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Cached Figma API documents
02_Inputs/figma_jsons/*.json
# API response cache contains temporary signed voice-preview URLs.
