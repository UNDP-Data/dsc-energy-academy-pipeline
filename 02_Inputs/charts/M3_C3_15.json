{
  backgroundColor: "#ffffff",
  textStyle: {
    fontFamily: "Proxima Nova, sans-serif",
    fontSize: 14,
    fontWeight: "normal",
    color: "#333333"
  },
  color: [
    "#fcc30b", "#0468b1", "#fd6925", "#c5192d", "#3f7e44",
    "#19486a", "#fd9d24", "#dd1367", "#4c9f38", "#0a97d9"
  ],
  grid: {
    bottom: 150
  },
  tooltip: {
    trigger: "item",
    textStyle: {
      fontSize: 14,
      color: "#ffffff"
    },
    backgroundColor: "rgba(50, 50, 50, 0.85)",
    borderColor: "#bbbbbb",
    formatter: function (params) {
      const d = [
        { min: 912, max: 1095, mean: 1003.5 },
        { min: 753, max: 912, mean: 832.5 },
        { min: 850, max: 1021, mean: 935.5 },
        { min: 403, max: 513, mean: 458 },
        { min: 213, max: 470, mean: 341.5 },
        { min: 149, max: 364, mean: 256.5 },
        { min: 190, max: 427, mean: 308.5 },
        { min: 92, max: 221, mean: 156.5 },
        { min: 85, max: 147, mean: 116 },
        { min: 6.1, max: 11, mean: 8.55 },
        { min: 5.1, max: 6.4, mean: 5.75 },
        { min: 14, max: 87, mean: 50.5 },
        { min: 27, max: 122, mean: 74.5 },
        { min: 23, max: 82, mean: 52.5 },
        { min: 23, max: 83, mean: 53 },
        { min: 8, max: 28, mean: 18 },
        { min: 10, max: 35, mean: 22.5 },
        { min: 7.4, max: 27, mean: 17.2 },
        { min: 9.2, max: 34, mean: 21.6 },
        { min: 7.8, max: 16, mean: 11.9 },
        { min: 13, max: 23, mean: 18 },
        { min: 12, max: 21, mean: 16.5 }
      ][params.dataIndex];
      return `<b>${params.name}</b><br/>
              Min: ${d.min}<br/>
              Max: ${d.max}<br/>
              Mean: ${d.mean}`;
    }
  },
  legend: {
    top: "bottom",
    type: "scroll",
    orient: "horizontal",
    textStyle: {
      fontSize: 14,
      color: "#333333"
    }
  },
  xAxis: {
    type: "category",
    data: [
      "PC, without CCS", "IGCC, without CCS", "SC, without CCS", "NGCC, without CCS",
      "PC, with CCS", "IGCC, with CCS", "SC, with CCS", "NGCC, with CCS",
      "660 MW", "360 MW", "average", "tower", "trough",
      "poly‑Si, ground‑mounted", "poly‑Si, roof‑mounted",
      "CdTe, ground‑mounted", "CdTe, roof‑mounted",
      "CIGS, ground‑mounted", "CIGS, roof‑mounted",
      "onshore", "offshore, concrete foundation", "offshore, steel foundation"
    ],
    axisLabel: {
      color: "#555555",
      fontSize: 14,
      rotate: 30
    },
    axisLine: {
      show: true,
      lineStyle: {
        color: "#cccccc",
        type: "solid",
        width: 1
      }
    },
    splitLine: {
      show: true,
      lineStyle: {
        type: "dashed",
        color: "#eeeeee",
        opacity: 0.7
      }
    },
    nameTextStyle: {
      color: "#444444",
      fontSize: 14
    }
  },
  yAxis: {
    type: "value",
    name: "Value",
    axisLabel: {
      color: "#555555",
      fontSize: 14
    },
    axisLine: {
      show: true,
      lineStyle: {
        color: "#cccccc",
        type: "solid",
        width: 1
      }
    },
    splitLine: {
      show: true,
      lineStyle: {
        type: "dashed",
        color: "#eeeeee",
        opacity: 0.7
      }
    },
    nameTextStyle: {
      color: "#444444",
      fontSize: 14
    }
  },
  series: [
    {
      name: "Whiskers",
      type: "custom",
      itemStyle: {
        color: "#bbbbbb"
      },
      renderItem: function (params, api) {
        const ci = api.value(0);
        const x = api.coord([ci, 0])[0];
        const minY = api.coord([0, api.value(1)])[1];
        const maxY = api.coord([0, api.value(2)])[1];
        const capWidth = 10;
        return {
          type: 'group',
          children: [
            { type: 'line', shape: { x1: x, y1: minY, x2: x, y2: maxY },
              style: { stroke: '#999999', lineWidth: 2 } },
            { type: 'line', shape: { x1: x-capWidth, y1: minY, x2: x+capWidth, y2: minY },
              style: { stroke: '#999999', lineWidth: 2 } },
            { type: 'line', shape: { x1: x-capWidth, y1: maxY, x2: x+capWidth, y2: maxY },
              style: { stroke: '#999999', lineWidth: 2 } }
          ]
        };
      },
      encode: { x: 0, y: [1,2] },
      data: [
        [0,912,1095],[1,753,912],[2,850,1021],[3,403,513],
        [4,213,470],[5,149,364],[6,190,427],[7,92,221],
        [8,85,147],[9,6.1,11],[10,5.1,6.4],[11,14,87],
        [12,27,122],[13,23,82],[14,23,83],[15,8,28],
        [16,10,35],[17,7.4,27],[18,9.2,34],[19,7.8,16],
        [20,13,23],[21,12,21]
      ]
    },
    {
      name: "Mean",
      type: "scatter",
      symbolSize: 12,
      itemStyle: {
        color: "#fcc30b"
      },
      emphasis: {
        itemStyle: { borderWidth: 1, borderColor: "#000000" }
      },
      data: [
        1003.5,832.5,935.5,458,341.5,256.5,308.5,156.5,
        116,8.55,5.75,50.5,74.5,52.5,53,18,22.5,17.2,21.6,11.9,18,16.5
      ]
    }
  ]
};
