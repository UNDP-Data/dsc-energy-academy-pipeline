  "tooltip": {
    "trigger": "axis",
    "backgroundColor": "rgba(30, 30, 30, 0.85)",
    "borderColor": "#555555",
    "textStyle": {
      "fontSize": 14,
      "color": "#FFFFFF"
    },
    "formatter": function (params) {
      return params
        .map((p) => `${p.seriesName}: ${p.data[1].toFixed(2)}`)
        .join("<br/>");
    }
  },

  "legend": {
    "data": ["Copper with recycling", "Copper without recycling"],
    "orient": "horizontal",
    "top": "bottom",
    "type": "scroll",
    "pageIconColor": "#FFFFFF",
    "pageIconInactiveColor": "#555555",
    "pageTextStyle": {
      "color": "#CCCCCC",
      "fontSize": 14
    },
    "textStyle": {
      "fontSize": 14,
      "color": "#CCCCCC"
    }
  },

  "xAxis": {
    "type": "time",
    "name": "Year",
    "axisLine": {
      "show": true,
      "lineStyle": {
        "color": "#888888",
        "type": "solid",
        "width": 1
      }
    },
    "splitLine": {
      "show": true,
      "lineStyle": {
        "type": "dashed",
        "color": "#444444",
        "opacity": 0.7
      }
    },
    "axisLabel": {
      "color": "#AAAAAA",
      "fontSize": 14
    },
    "nameTextStyle": {
      "color": "#CCCCCC",
      "fontSize": 14
    }
  },

  "yAxis": {
    "type": "value",
    "name": "Mt",
    "axisLine": {
      "show": true,
      "lineStyle": {
        "color": "#888888",
        "type": "solid",
        "width": 1
      }
    },
    "splitLine": {
      "show": true,
      "lineStyle": {
        "type": "dashed",
        "color": "#444444",
        "opacity": 0.7
      }
    },
    "axisLabel": {
      "color": "#AAAAAA",
      "fontSize": 14
    },
    "nameTextStyle": {
      "color": "#CCCCCC",
      "fontSize": 14
    }
  },

  "label": {
    "overflow": "truncate",
    "ellipsis": "..."
  },

  "emphasis": {
    "itemStyle": {
      "borderWidth": 1,
      "borderColor": "#FFFFFF"
    }
  },

  "accessibility": {
    "contrastRatioMin": 4.5,
    "colorBlindSafe": true
  },

  "hoverLayerThreshold": 3000,
  "tooltipTrigger": "axis",

