{
  backgroundColor: "rgba(247, 247, 247, 1)",
  textStyle: {
    fontFamily: "Proxima Nova, sans-serif",
    fontSize: 14,
    fontWeight: "normal",
    color: "#666666"
  },
  color: [
    "#fcc30b", "#0468b1", "#fd6925", "#c5192d", "#3f7e44",
    "#19486a", "#fd9d24", "#dd1367", "#4c9f38", "#0a97d9"
  ],
  grid: {
    bottom: 150
  },
  tooltip: {
    trigger: "item",
    textStyle: {
      fontSize: 14,
      color: "#FFFFFF"
    },
    backgroundColor: "rgba(50, 50, 50, 0.85)",
    borderColor: "#CCCCCC",
    formatter: function (params) {
      const d = [
        { "min": 6.73, "max": 23.63, "mean": 15.5, "median": 13.79 },
        { "min": 5.94, "max": 19.96, "mean": 13.86, "median": 11.11 },
        { "min": 0.0, "max": 18.78, "mean": 12.08, "median": 10.0 },
        { "min": 5.1, "max": 16.71, "mean": 10.59, "median": 9.09 },
        { "min": 0.0, "max": 18.22, "mean": 12.11, "median": 10.0 },
        { "min": 5.94, "max": 19.96, "mean": 12.95, "median": 10.56 },
        { "min": 0.0, "max": 18.22, "mean": 10.79, "median": 9.09 },
        { "min": 6.19, "max": 19.98, "mean": 13.45, "median": 10.0 },
        { "min": 7.69, "max": 24.95, "mean": 17.14, "median": 16.67 },
        { "min": 7.69, "max": 24.77, "mean": 16.5, "median": 15.38 },
        { "min": 13.31, "max": 28.11, "mean": 20.31, "median": 22.22 },
        { "min": 7.14, "max": 26.69, "mean": 17.99, "median": 16.95 }
      ][params.dataIndex];
      const categories = [
        "Non-energy", "Total energy and utilities", "Total energy",
        "Coal", "Oil & gas", "Oil & gas equipment and services",
        "Renewable energy", "Uranium", "Total energy utilities",
        "Electric utilities and IPPs", "Multiline utilities", "Natural gas utilities"
      ];
      return `<b>${categories[params.dataIndex]}</b><br/>
              Min: ${d.min}<br/>
              Max: ${d.max}<br/>
              Mean: ${d.mean}<br/>
              Median: ${d.median}`;
    }
  },
  legend: {
    top: "bottom",
    type: "scroll",
    orient: "horizontal",
    textStyle: {
      fontSize: 14,
      color: "#444444"
    }
  },
  xAxis: {
    type: "category",
    data: [
      "Non-energy", "Total energy and utilities", "Total energy",
      "Coal", "Oil & gas", "Oil & gas equipment and services",
      "Renewable energy", "Uranium", "Total energy utilities",
      "Electric utilities and IPPs", "Multiline utilities", "Natural gas utilities"
    ],
    axisLabel: {
      color: "#666666",
      fontSize: 14,
      rotate: 30
    },
    axisLine: {
      show: true,
      lineStyle: {
        color: "#999999",
        type: "solid",
        width: 1
      }
    },
    splitLine: {
      show: true,
      lineStyle: {
        type: "dashed",
        color: "#DDDDDD",
        opacity: 0.7
      }
    },
    nameTextStyle: {
      color: "#444444",
      fontSize: 14
    }
  },
  yAxis: {
    type: "value",
    name: "Value",
    axisLabel: {
      color: "#666666",
      fontSize: 14
    },
    axisLine: {
      show: true,
      lineStyle: {
        color: "#999999",
        type: "solid",
        width: 1
      }
    },
    splitLine: {
      show: true,
      lineStyle: {
        type: "dashed",
        color: "#EEEEEE",
        opacity: 0.7
      }
    },
    nameTextStyle: {
      color: "#444444",
      fontSize: 14
    }
  },
  series: [
    {
      name: "Min/Max",
      type: "custom",
        "itemStyle": {
    "color": "#999999"  // This should match the stroke color you use for whiskers
  },
      renderItem: function (params, api) {
        const categoryIndex = api.value(0);
        const x = api.coord([categoryIndex, 0])[0];
        const minY = api.coord([0, api.value(1)])[1];
        const maxY = api.coord([0, api.value(2)])[1];
        const capWidth = 10;

        return {
          type: 'group',
          children: [
            {
              type: 'line',
              shape: {
                x1: x, y1: minY,
                x2: x, y2: maxY
              },
              style: {
                stroke: '#999999',
                lineWidth: 2
              }
            },
            {
              type: 'line',
              shape: {
                x1: x - capWidth, y1: minY,
                x2: x + capWidth, y2: minY
              },
              style: {
                stroke: '#999999',
                lineWidth: 2
              }
            },
            {
              type: 'line',
              shape: {
                x1: x - capWidth, y1: maxY,
                x2: x + capWidth, y2: maxY
              },
              style: {
                stroke: '#999999',
                lineWidth: 2
              }
            }
          ]
        };
      },
      encode: {
        x: 0,
        y: [1, 2]
      },
      data: [
        [0, 6.73, 23.63], [1, 5.94, 19.96], [2, 0, 18.78],
        [3, 5.1, 16.71], [4, 0, 18.22], [5, 5.94, 19.96],
        [6, 0, 18.22], [7, 6.19, 19.98], [8, 7.69, 24.95],
        [9, 7.69, 24.77], [10, 13.31, 28.11], [11, 7.14, 26.69]
      ]
    },
    {
      name: "Mean",
      type: "scatter",
      symbolSize: 12,
      itemStyle: {
        color: "#fcc30b"
      },
      emphasis: {
        itemStyle: {
          borderWidth: 1,
          borderColor: "#000000"
        }
      },
      data: [
        15.5, 13.86, 12.08, 10.59, 12.11, 12.95,
        10.79, 13.45, 17.14, 16.5, 20.31, 17.99
      ]
    },
    {
      name: "Median",
      type: "scatter",
      symbolSize: 12,
      itemStyle: {
        color: "#0468b1"
      },
      emphasis: {
        itemStyle: {
          borderWidth: 1,
          borderColor: "#000000"
        }
      },
      data: [
        13.79, 11.11, 10, 9.09, 10, 10.56,
        9.09, 10, 16.67, 15.38, 22.22, 16.95
      ]
    }
  ]
}
