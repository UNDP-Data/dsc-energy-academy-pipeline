{
  "id": "4.1.1",
  "segments": [
    {
      "template_id": "lesson_cover",
      "color_scheme": "dark",
      "content": {
        "image": {
          "src": "https://sehseadata.blob.core.windows.net/images/Photos/Module_5/M5_C4_L2_5.png",
