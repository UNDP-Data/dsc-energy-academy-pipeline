{
  "id": "2.2.2",
  "segments": [
    {
      "template_id": "lesson_cover",
      "color_scheme": "dark",
      "content": {
        "image": {
          "src": "https://sehseadata.blob.core.windows.net/images/Modules/Module_2/406_3075.webp",
