{
  "id": "5.4.4",
  "segments": [
    {
      "template_id": "lesson_cover",
      "color_scheme": "dark",
      "content": {
        "image": {
          "src": "https://sehseadata.blob.core.windows.net/images/Modules/Module_5/3983_3266.webp",
          "caption": ""
